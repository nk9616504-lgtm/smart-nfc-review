<!DOCTYPE html>
<html lang="ta">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart NFC & QR Admin (500 Cards)</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
    body { margin: 0; background: #f3f4f6; color: #1f2937; }
    header { background: #1e3a8a; color: white; padding: 16px; text-align: center; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
    header h1 { margin: 0; font-size: 20px; }
    header p { margin: 4px 0 0; font-size: 12px; opacity: 0.85; }
    .container { max-width: 800px; margin: 16px auto; padding: 0 12px; }
    .search-box { width: 100%; padding: 12px 16px; border: 2px solid #cbd5e1; border-radius: 10px; font-size: 16px; margin-bottom: 16px; outline: none; }
    .search-box:focus { border-color: #2563eb; }
    .card { background: white; border-radius: 12px; padding: 16px; margin-bottom: 14px; box-shadow: 0 2px 5px rgba(0,0,0,0.06); border-left: 5px solid #2563eb; }
    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .card-id { font-weight: bold; font-size: 16px; color: #1e3a8a; background: #dbeafe; padding: 4px 10px; border-radius: 6px; }
    .status { font-size: 12px; padding: 3px 8px; border-radius: 12px; font-weight: 600; }
    .active { background: #dcfce7; color: #166534; }
    .empty { background: #fee2e2; color: #991b1b; }
    input[type="text"], input[type="url"] { width: 100%; padding: 10px; margin: 6px 0; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; }
    .btn-group { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    button { border: none; padding: 9px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: 0.2s; }
    .btn-save { background: #16a34a; color: white; flex: 1; }
    .btn-qr { background: #2563eb; color: white; }
    .btn-copy { background: #4b5563; color: white; }
    .redirect-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; text-align: center; padding: 20px; background: white; }
    .loader { border: 5px solid #e5e7eb; border-top: 5px solid #2563eb; border-radius: 50%; width: 45px; height: 45px; animation: spin 0.8s linear infinite; margin-bottom: 16px; }
    @keyframes spin { 100% { transform: rotate(360deg); } }
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 200; }
    .modal-content { background: white; padding: 24px; border-radius: 14px; text-align: center; max-width: 320px; width: 90%; }
    #qrcode { display: flex; justify-content: center; margin: 16px 0; }
  </style>
</head>
<body>

  <!-- Redirect Screen for Customers -->
  <div id="redirectView" class="redirect-screen" style="display:none;">
    <div class="loader"></div>
    <h2 id="redirectText">Google Review பக்கத்திற்குச் செல்கிறது...</h2>
  </div>

  <!-- Admin Dashboard View -->
  <div id="adminView" style="display:none;">
    <header>
      <h1>Smart NFC & QR Admin Panel</h1>
      <p>500 Cards Management | Spot Link Editor</p>
    </header>
    <div class="container">
      <input type="text" id="searchInput" class="search-box" placeholder="🔍 கார்டு எண் (எ.கா: 001) அல்லது கடை பெயர் தேடவும்..." onkeyup="filterCards()" />
      <div id="cardsList"></div>
    </div>
  </div>

  <!-- QR Code Popup Modal -->
  <div id="qrModal" class="modal" onclick="closeModal(event)">
    <div class="modal-content">
      <h3 id="modalTitle" style="margin:0;">Card 001</h3>
      <div id="qrcode"></div>
      <p id="modalUrl" style="font-size:11px; word-break:break-all; color:#4b5563;"></p>
      <button class="btn-save" style="width:100%; margin-top:8px;" onclick="downloadQR()">⬇️ QR Image டவுன்லோட் செய்</button>
    </div>
  </div>

