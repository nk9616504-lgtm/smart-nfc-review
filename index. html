<!DOCTYPE html>
<html lang="ta">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Smart NFC & QR Admin (500 Cards)</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', sans-serif; }
    body { margin: 0; background: #f3f4f6; color: #1f2937; }
    header { background: #1e3a8a; color: white; padding: 16px; text-align: center; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 6px rgba(0,0,0,0.15); }
    header h1 { margin: 0; font-size: 20px; }
    header p { margin: 4px 0 0; font-size: 12px; opacity: 0.85; }
    .container { max-width: 800px; margin: 16px auto; padding: 0 12px; }
    .search-box { width: 100%; padding: 12px 16px; border: 2px solid #cbd5e1; border-radius: 10px; font-size: 16px; margin-bottom: 16px; outline: none; }
    .search-box:focus { border-color: #2563eb; }
    .card { background: white; border-radius: 12px; padding: 16px; margin-bottom: 14px; box-shadow: 0 2px 5px rgba(0,0,0,0.06); border-left: 5px solid #2563eb; }
    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .card-id { font-weight: bold; font-size: 16px; color: #1e3a8a; background: #dbeafe; padding: 4px 10px; border-radius: 6px; }
    .status { font-size: 12px; padding: 3px 8px; border-radius: 12px; font-weight: 600; }
    .active { background: #dcfce7; color: #166534; }
    .empty { background: #fee2e2; color: #991b1b; }
    input[type="text"], input[type="url"] { width: 100%; padding: 10px; margin: 6px 0; border: 1px solid #d1d5db; border-radius: 8px; font-size: 14px; }
    .btn-group { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    button { border: none; padding: 9px 14px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: 0.2s; }
    .btn-save { background: #16a34a; color: white; flex: 1; }
    .btn-qr { background: #2563eb; color: white; }
    .btn-copy { background: #4b5563; color: white; }
    .redirect-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; text-align: center; padding: 20px; }
    .loader { border: 5px solid #e5e7eb; border-top: 5px solid #2563eb; border-radius: 50%; width: 45px; height: 45px; animation: spin 0.8s linear infinite; margin-bottom: 16px; }
    @keyframes spin { 100% { transform: rotate(360deg); } }
    /* Modal for QR */
    .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); align-items: center; justify-content: center; z-index: 200; }
    .modal-content { background: white; padding: 24px; border-radius: 14px; text-align: center; max-width: 320px; width: 90%; }
    #qrcode { display: flex; justify-content: center; margin: 16px 0; }
  </style>
</head>
<body>

  <!-- Redirect Screen for Customers -->
  <div id="redirectView" class="redirect-screen" style="display:none;">
    <div class="loader"></div>
    <h2 id="redirectText">Google Review பக்கத்திற்குச் செல்கிறது...</h2>
  </div>

  <!-- Admin Dashboard View -->
  <div id="adminView" style="display:none;">
    <header>
      <h1>Smart NFC & QR Admin Panel</h1>
      <p>500 Cards Management | Spot Link Editor</p>
    </header>
    <div class="container">
      <input type="text" id="searchInput" class="search-box" placeholder="🔍 கார்டு எண் (எ.கா: 001) அல்லது கடை பெயர் தேடவும்..." onkeyup="filterCards()" />
      <div id="cardsList"></div>
    </div>
  </div>

  <!-- QR Code Popup Modal -->
  <div id="qrModal" class="modal" onclick="closeModal(event)">
    <div class="modal-content">
      <h3 id="modalTitle" style="margin:0;">Card 001</h3>
      <div id="qrcode"></div>
      <p id="modalUrl" style="font-size:11px; word-break:break-all; color:#4b5563;"></p>
      <button class="btn-save" style="width:100%; margin-top:8px;" onclick="downloadQR()">⬇️ QR Image டவுன்லோட் செய்</button>
    </div>
  </div>

  <script>
    // உங்கள் Firebase Realtime Database URL இணைக்கப்பட்டுள்ளது
    const FIREBASE_DB_URL = "https://nfc-review-app-1ed32-default-rtdb.firebaseio.com";

    const TOTAL_CARDS = 500;
    let cardsData = {};
    const urlParams = new URLSearchParams(window.location.search);
    const cardIdParam = urlParams.get('id');

    // 1. கஸ்டமர் கார்டை Tap அல்லது Scan செய்தால் உடனே Redirect ஆகும் பகுதி
    if (cardIdParam) {
      document.getElementById('redirectView').style.display = 'flex';
      fetch(`${FIREBASE_DB_URL}/cards/${cardIdParam}.json`)
        .then(res => res.json())
        .then(data => {
          if (data && data.url) {
            window.location.replace(data.url);
          } else {
            document.getElementById('redirectText').innerText = "இந்த கார்டு இன்னும் ஆக்டிவேட் செய்யப்படவில்லை (Not Activated).";
          }
        })
        .catch(() => {
          document.getElementById('redirectText').innerText = "இணைய இணைப்பைச் சரிபார்க்கவும்.";
        });
    } else {
      // 2. அட்மின் டேஷ்போர்டு லோட் ஆகும் பகுதி
      document.getElementById('adminView').style.display = 'block';
      loadAllCards();
    }

    function loadAllCards() {
      fetch(`${FIREBASE_DB_URL}/cards.json`)
        .then(res => res.json())
        .then(data => {
          cardsData = data || {};
          renderCards(1, 50); // வேகமாக லோட் ஆக முதலில் 50 கார்டுகள் காட்டும், தேடும்போது 500-ம் வரும்
        });
    }

    function renderCards(start, end, filterText = "") {
      const container = document.getElementById('cardsList');
      container.innerHTML = "";
      const baseUrl = window.location.origin + window.location.pathname;

      for (let i = 1; i <= TOTAL_CARDS; i++) {
        const idStr = String(i).padStart(3, '0');
        const cardKey = `card${idStr}`;
        const info = cardsData[cardKey] || { shop: "", url: "" };

        if (filterText) {
          const matchId = idStr.includes(filterText) || cardKey.includes(filterText.toLowerCase());
          const matchShop = info.shop.toLowerCase().includes(filterText.toLowerCase());
          if (!matchId && !matchShop) continue;
        } else if (i > end) {
          break;
        }

        const isActive = info.url && info.url.trim() !== "";
        const cardHtml = `
          <div class="card">
            <div class="card-header">
              <span class="card-id">CARD #${idStr}</span>
              <span class="status ${isActive ? 'active' : 'empty'}">${isActive ? '● Active' : '○ Empty'}</span>
            </div>
            <input type="text" id="shop_${cardKey}" placeholder="கடையின் பெயர் (Shop Name)" value="${info.shop || ''}" />
            <input type="url" id="url_${cardKey}" placeholder="Google Review Link இங்கே பேஸ்ட் செய்யவும்" value="${info.url || ''}" />
            <div class="btn-group">
              <button class="btn-save" onclick="saveCard('${cardKey}')">💾 Save Link</button>
              <button class="btn-qr" onclick="showQR('${cardKey}', '${baseUrl}?id=${cardKey}')">📱 QR Code</button>
              <button class="btn-copy" onclick="copyLink('${baseUrl}?id=${cardKey}')">📋 NFC Link</button>
            </div>
          </div>
        `;
        container.insertAdjacentHTML('beforeend', cardHtml);
      }
    }

    function filterCards() {
      const text = document.getElementById('searchInput').value.trim();
      renderCards(1, text ? 500 : 50, text);
    }

    function saveCard(cardKey) {
      const shop = document.getElementById(`shop_${cardKey}`).value.trim();
      const url = document.getElementById(`url_${cardKey}`).value.trim();
      fetch(`${FIREBASE_DB_URL}/cards/${cardKey}.json`, {
        method: 'PUT',
        body: JSON.stringify({ shop, url })
      }).then(() => {
        cardsData[cardKey] = { shop, url };
        alert(`✅ ${cardKey.toUpperCase()} வெற்றிகரமாக அப்டேட் செய்யப்பட்டது!`);
        filterCards();
      });
    }

    function copyLink(link) {
      navigator.clipboard.writeText(link);
      alert("📋 NFC லிங்க் காப்பி செய்யப்பட்டது! NFC Tools ஆப்பில் இதை Write செய்யவும்:\n" + link);
    }

    let currentQRTitle = "";
    function showQR(cardKey, fullUrl) {
      currentQRTitle = cardKey;
      document.getElementById('modalTitle').innerText = cardKey.toUpperCase();
      document.getElementById('modalUrl').innerText = fullUrl;
      const qrDiv = document.getElementById('qrcode');
      qrDiv.innerHTML = "";
      new QRCode(qrDiv, { text: fullUrl, width: 200, height: 200, correctLevel: QRCode.CorrectLevel.H });
      document.getElementById('qrModal').style.display = 'flex';
    }

    function downloadQR() {
      const img = document.querySelector('#qrcode img') || document.querySelector('#qrcode canvas');
      const link = document.createElement('a');
      link.download = `${currentQRTitle}_QR.png`;
      link.href = img.tagName === 'IMG' ? img.src : img.toDataURL();
      link.click();
    }

    function closeModal(e) {
      if (e.target.id === 'qrModal') document.getElementById('qrModal').style.display = 'none';
    }
  </script>
</body>
</html>
